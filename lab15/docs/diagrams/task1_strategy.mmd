    class PerKmTariff
    class CombinedTariff
    class CorporateFixedTariff
    class NightTariff
    Trip "1" o-- "1" TariffStrategy : tariff
    TariffStrategy <|.. PerMinuteTariff
    TariffStrategy <|.. PerKmTariff
    TariffStrategy <|.. CombinedTariff
    TariffStrategy <|.. CorporateFixedTariff
    TariffStrategy <|.. NightTariff
    note for Trip "Context"
